# Copy to .env and fill in real values. Never commit .env.

# OpenProject API
OPENPROJECTTOKEN=
# Or, mount a secret file and point here instead (compose secrets, k8s, etc.)
#OPENPROJECTTOKEN_FILE=/run/secrets/openproject_token
OPENPROJECT_URL=https://projects-customdev.wone-it.ru
PROJECT_IDENTIFIER=dom-zhkkh
BUG_TYPE_NAME=Bug

# Postgres — these credentials are used both by the postgres container
# (POSTGRES_DB/USER/PASSWORD) and by the extractor (HOST/PORT default to
# localhost:5433, which is what `psql` from the host uses; docker-compose
# overrides them to postgres:5432 inside the network).
POSTGRES_DB=extractor
POSTGRES_USER=extractor
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Sync loop interval. Cycle takes ~15s for ~750 bugs, so 300s is comfortable.
SYNC_INTERVAL_SECONDS=300
